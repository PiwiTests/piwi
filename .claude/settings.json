{
  "permissions": {
    "allow": [
      "Bash(npm run app:typecheck)",
      "Bash(npm run app:lint)",
      "Bash(npm run app:format:check)",
      "Bash(npm run app:test:unit)",
      "Bash(npm run reporter:typecheck)",
      "Bash(npm run reporter:lint)",
      "Bash(npm run reporter:test)",
      "Bash(npm run knip)",
      "Bash(npm test)",
      "Bash(npx vitest run:*)",
      "Bash(npx commitlint:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
