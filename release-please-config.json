{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "tag-separator": "-",
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "package-name": "piwi",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "packages/core/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/picker-dom/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/server/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/application/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/reporter/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/editor/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "integrations/nitro/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/desktop/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/desktop/src-tauri/tauri.conf.json", "jsonpath": "$.version" },
        { "type": "generic", "path": "apps/desktop/src-tauri/Cargo.toml" },
        { "type": "json", "path": "apps/extension/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/extension/manifest.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/vscode/package.json", "jsonpath": "$.version" },
        { "type": "generic", "path": "apps/jetbrains/gradle.properties" },
        {
          "type": "json",
          "path": "examples/playwright-fixtures/package.json",
          "jsonpath": "$.devDependencies['@piwitests/reporter']"
        },
        {
          "type": "json",
          "path": "examples/playwright-fixtures/package.json",
          "jsonpath": "$.devDependencies['@piwitests/instrumentation-nitro']"
        },
        {
          "type": "json",
          "path": "examples/sample-app/package.json",
          "jsonpath": "$.devDependencies['@piwitests/reporter']"
        },
        {
          "type": "generic",
          "path": "examples/sample-app/backends/aspnetcore/SampleApp.AspNetCore.csproj"
        },
        {
          "type": "generic",
          "path": "integrations/aspnetcore/PiwiTests.Instrumentation.AspNetCore/PiwiTests.Instrumentation.AspNetCore.csproj"
        },
        {
          "type": "generic",
          "path": "integrations/aspnetcore/PiwiTests.Instrumentation.Core/PiwiTests.Instrumentation.Core.csproj"
        },
        {
          "type": "generic",
          "path": "integrations/aspnetcore/PiwiTests.Instrumentation.Coverage/PiwiTests.Instrumentation.Coverage.csproj"
        },
        {
          "type": "generic",
          "path": "integrations/serilog/PiwiTests.Instrumentation.Serilog/PiwiTests.Instrumentation.Serilog.csproj"
        },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['packages/core'].version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['packages/picker-dom'].version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['packages/server'].version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['packages/reporter'].version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['packages/editor'].version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['apps/application'].version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['apps/extension'].version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['apps/vscode'].version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['integrations/nitro'].version" }
      ]
    }
  }
}
