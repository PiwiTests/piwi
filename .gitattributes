# Normalize text files to LF on commit; checkout with native line endings
* text=auto eol=lf

# Binary files — never normalize or diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.sqlite binary
*.db binary
*.webm binary
*.mp4 binary

# The showcase's videos, filmed again for each release, live in Git LFS: each take adds a pointer to the history, not
# the video. The docs deploy checks them out (`lfs: true`), and .husky/pre-push uploads them.
apps/docs/public/videos/showcase-*.mp4 filter=lfs diff=lfs merge=lfs -text
