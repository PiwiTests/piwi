<!--
  Installed, updated and removed without a restart: on unload the platform stops the editor service with the LSP
  provider, the project services are disposed, and the work they queued expires with them.
-->
<idea-plugin>
    <id>dev.piwitests.piwi</id>
    <name>Piwi</name>
    <vendor url="https://piwitests.dev">Piwi</vendor>
    <description><![CDATA[
    <p>Your Playwright suite's history, from a <a href="https://piwitests.dev">Piwi</a> instance, at the line you are
    editing. Piwi keeps every run CI throws away, groups the failures by root cause and finds the locator you should
    have used; this plugin brings that to WebStorm, IntelliJ IDEA Ultimate and Rider.</p>

    <p><b>You need a Piwi instance:</b> the <a href="https://piwitests.dev/features/desktop">desktop app</a>,
    <code>npx @piwitests/server</code> or the Docker image. Recording needs none. Piwi reads Playwright Test suites in
    JavaScript and TypeScript.</p>

    <p><b>What it shows</b></p>
    <ul>
      <li><b>The latest CI failures at their lines.</b> Each failure of the latest run on your branch is an error at
          the line that failed, with the reason, the screenshot and the trace one action away. A run you make locally
          lays over it the moment it ends: a test you fixed leaves, one you broke joins.</li>
      <li><b>The heal as a quick fix.</b> On a broken locator, the replacement Piwi recommends from the last passing
          run is an Alt+Enter away: the same edit an auto-heal pull request would make.</li>
      <li><b>The Piwi tool window.</b> The run's failures as a tree, grouped by file, cluster or owner, with your runs
          since; each test re-runs, opens its trace or its page from its right-click menu. Compare with another branch, a run by
          its id, or your local runs only.</li>
      <li><b>The tests behind each line.</b> Each test's latest result in the gutter, a failing test's body tinted,
          and above each locator line and each application file the tests that use or reach it, ready to run.</li>
      <li><b>Coverage marks.</b> With coverage recorded, the lines your tests ran, in TypeScript, JavaScript and C#
          alike, the tests behind each function, and the lines changed since the coverage run.</li>
      <li><b>Brittle locators and breaking changes.</b> A warning on a locator that will not survive a restyle, and
          on an unsaved change that renames a string your tests find elements by, each with a quick fix.</li>
      <li><b>Tests recorded at the caret.</b> <b>Record here…</b> opens a browser through your project's own
          Playwright and writes what you do there into the test, calling your page objects when connected. No
          instance needed.</li>
      <li><b>The status bar.</b> The latest run of the Playwright config you are editing in, the run you started as it
          runs, and what it changed once it ended, in red while tests fail; a click lists Piwi's actions. That run
          pauses at your breakpoints, its paused line marked in the editor, and steps, runs to the caret or resumes
          with the debugger's keys; from the paused line, the plugin writes an assertion or a mock of a request the
          page made.</li>
    </ul>

    <p><b>Connect</b></p>
    <p>The plugin reads the connection the Piwi reporter already uses (the environment, the workspace <code>.env</code>
    or the Piwi desktop app). Otherwise, <b>Settings → Tools → Piwi</b> signs you in with the browser. Paths clicked in
    the dashboard open at their line in the IDE, and locators picked in the Piwi Picker browser extension land at the
    caret. Piwi's MCP server is one copy away for the AI Assistant.</p>

    <p>Self-hosted, zero telemetry. No file of your workspace is sent to the instance: its locator index, code reach
    and latest run are compared with your files locally.</p>

    <p>Works in WebStorm, IntelliJ IDEA Ultimate, Rider and the other JetBrains IDEs with the LSP API and JavaScript
    support, from 2024.1, with Node.js 20 or later. Documentation:
    <a href="https://piwitests.dev/features/editors">piwitests.dev/features/editors</a>.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.ultimate</depends>
    <depends>JavaScript</depends>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="dev.piwitests.jetbrains.PiwiStartupActivity"/>
        <platform.lsp.serverSupportProvider implementation="dev.piwitests.jetbrains.PiwiLspServerSupportProvider"/>
        <codeInsight.daemonBoundCodeVisionProvider implementation="dev.piwitests.jetbrains.PiwiCodeVisionProvider"/>
        <codeInsight.daemonBoundCodeVisionProvider implementation="dev.piwitests.jetbrains.PiwiCodeVisionSlot2"/>
        <codeInsight.daemonBoundCodeVisionProvider implementation="dev.piwitests.jetbrains.PiwiCodeVisionSlot3"/>
        <codeInsight.daemonBoundCodeVisionProvider implementation="dev.piwitests.jetbrains.PiwiCodeVisionSlot4"/>
        <codeInsight.daemonBoundCodeVisionProvider implementation="dev.piwitests.jetbrains.PiwiCodeVisionSlot5"/>
        <codeInsight.daemonBoundCodeVisionProvider implementation="dev.piwitests.jetbrains.PiwiCodeVisionSlot6"/>
        <codeInsight.daemonBoundCodeVisionProvider implementation="dev.piwitests.jetbrains.PiwiCodeVisionSlot7"/>
        <codeInsight.daemonBoundCodeVisionProvider implementation="dev.piwitests.jetbrains.PiwiCodeVisionSlot8"/>
        <config.codeVisionGroupSettingProvider implementation="dev.piwitests.jetbrains.PiwiCodeVisionSettings"/>
        <externalAnnotator language="JavaScript" implementationClass="dev.piwitests.jetbrains.PiwiTestAnnotator"/>
        <externalAnnotator language="JavaScript" implementationClass="dev.piwitests.jetbrains.PiwiRecordingAnnotator"/>
        <intentionAction>
            <language>JavaScript</language>
            <className>dev.piwitests.jetbrains.RecordHereIntention</className>
            <category>Piwi</category>
        </intentionAction>
        <editorNotificationProvider implementation="dev.piwitests.jetbrains.PiwiRecordingNotificationProvider"/>
        <colorSettingsPage implementation="dev.piwitests.jetbrains.PiwiColorSettingsPage"/>
        <additionalTextAttributes scheme="Default" file="colorSchemes/PiwiDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/PiwiDarcula.xml"/>
        <!-- The New UI's outline mark at 16 and 20 px in place of the classic filled one, written by the brand generator. -->
        <iconMapper mappingFile="PiwiIconMappings.json"/>
        <statusBarWidgetFactory id="piwi.status" implementation="dev.piwitests.jetbrains.PiwiStatusBarWidgetFactory"/>
        <!-- The Paused page and Worker tabs close; the failures tab does not (isCloseable = false). -->
        <toolWindow id="Piwi" anchor="bottom" icon="/icons/piwi.svg" canCloseContents="true"
                    factoryClass="dev.piwitests.jetbrains.PiwiFailuresToolWindowFactory"/>
        <projectConfigurable parentId="tools" id="dev.piwitests.piwi" displayName="Piwi"
                             instance="dev.piwitests.jetbrains.PiwiConfigurable"/>
        <search.optionContributor implementation="dev.piwitests.jetbrains.PiwiSearchableOptions"/>
        <notificationGroup id="Piwi" displayType="BALLOON"/>
        <notificationGroup id="Piwi requests" displayType="STICKY_BALLOON"/>
        <notificationGroup id="Piwi suggestions" displayType="BALLOON"/>
        <notificationGroup id="Piwi problems" displayType="BALLOON"/>
        <notificationGroup id="Piwi confirmations" displayType="BALLOON"/>
        <httpRequestHandler implementation="dev.piwitests.jetbrains.PiwiSendHandler"/>
        <httpRequestHandler implementation="dev.piwitests.jetbrains.PiwiOpenHandler"/>
        <!-- A run's controls go first among the actions their shortcut runs, while a run is live (below). -->
        <actionPromoter implementation="dev.piwitests.jetbrains.PiwiRunActionPromoter"/>
    </extensions>

    <!--
      The shortcuts go in the default keymap, which every bundled keymap descends from: the macOS keymaps turn their
      ctrl into the command key. Each typing action's is a ctrl alt shift chord, which some bundled plugins and keymaps
      also bind (the list is in apps/vscode/ARCHITECTURE.md, Keybindings); a run's controls use the debugger's shortcuts
      while they apply (below).
    -->
    <actions>
        <group id="Piwi.Actions" text="Piwi" popup="true" compact="true">
            <!--
              Six sections in this order, each showing only what applies: Run, Record, Run control (while a run is
              live), Dashboard, Agents, Connection.
            -->
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <group id="Piwi.Run" text="Run" compact="true">
                <action id="Piwi.RunTestAtCursor" class="dev.piwitests.jetbrains.RunTestAtCursorAction"
                        text="Run the test at the caret" icon="AllIcons.Actions.Execute"
                        description="Run the test whose test(…) call holds the caret, in the Run tool window, with the breakpoints">
                    <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift K"/>
                </action>
                <action id="Piwi.VerifyTestAtCursor" class="dev.piwitests.jetbrains.VerifyTestAtCursorAction"
                        text="Verify the test at the caret ×3"
                        icon="AllIcons.Actions.Rerun"
                        description="Run the test whose test(…) call holds the caret 3 times without retries, headless unless Run headed is on, and say how many runs passed">
                </action>
                <action id="Piwi.RunSpec" class="dev.piwitests.jetbrains.RunSpecAction" text="Run this spec"
                        icon="AllIcons.Actions.RunAll"
                        description="Run the tests of this spec Piwi knows, in the Run tool window, with the breakpoints">
                </action>
                <action id="Piwi.RunTestsForFile" icon="/icons/testsForFile.svg" class="dev.piwitests.jetbrains.RunTestsForFileAction"
                        text="Run the tests that reach this file" description="Run them in the Run tool window">
                </action>
                <action id="Piwi.RunSelection" class="dev.piwitests.jetbrains.RunSelectionAction" text="Run a saved selection…"
                        icon="AllIcons.Actions.ListFiles"
                        description="Run one of the project's saved selections"/>
                <action id="Piwi.RerunFailing" class="dev.piwitests.jetbrains.RerunFailingAction"
                        text="Re-run the failing tests" icon="AllIcons.RunConfigurations.RerunFailedTests"
                        description="Run every test that still fails, or whose failing line changed since its run">
                    <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift F"/>
                    <synonym text="Rerun failed tests"/>
                </action>
                <action id="Piwi.RunHeaded" class="dev.piwitests.jetbrains.RunHeadedAction" text="Run headed"
                        description="Run every test Piwi starts in this project headed, with its browser window shown"/>
                <action id="Piwi.RunHoldFailures" class="dev.piwitests.jetbrains.RunHoldFailuresAction"
                        text="Hold failures from each run's start…"
                        icon="AllIcons.Debugger.Db_exception_breakpoint"
                        description="Auto, On or Off: whether a failed test of each run Piwi starts waits at its line for an answer"/>
            </group>
            <separator/>
            <group id="Piwi.Record" text="Record" compact="true">
                <action id="Piwi.RecordHere" class="dev.piwitests.jetbrains.RecordHereAction" text="Record here…"
                        icon="AllIcons.Ide.Macro.Recording_1"
                        description="Open a browser with the project's Playwright and write what you do there at the caret: steps of the test, method or function it is in, else a new test">
                    <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift R"/>
                    <synonym text="Playwright codegen"/>
                    <synonym text="Record a test"/>
                </action>
                <action id="Piwi.RecordNewFile" class="dev.piwitests.jetbrains.RecordNewFileAction"
                        text="Record a new test file…" icon="AllIcons.Ide.Macro.Recording_1"
                        description="Create a spec file, then write what you do in a browser the project's Playwright opens into it">
                    <add-to-group group-id="NewGroup" anchor="last"/>
                    <synonym text="Playwright codegen"/>
                </action>
                <action id="Piwi.StopRecording" class="dev.piwitests.jetbrains.StopRecordingAction" text="Stop recording"
                        icon="AllIcons.Actions.Suspend"
                        description="Close the recording's browser; the recorded lines stay, one undo away">
                    <!-- Record here's chord: the two never apply to the same file at once. -->
                    <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift R"/>
                </action>
                <action id="Piwi.PauseRecording" class="dev.piwitests.jetbrains.PauseRecordingAction" text="Pause recording"
                        icon="AllIcons.Actions.Pause"
                        description="Stop writing what is done in the browser until Resume">
                </action>
                <action id="Piwi.ResumeRecording" class="dev.piwitests.jetbrains.ResumeRecordingAction" text="Resume recording"
                        icon="AllIcons.Actions.Resume"
                        description="Write what is done in the browser again, over the recorded lines">
                </action>
                <action id="Piwi.PairPicker" icon="/icons/pair.svg" class="dev.piwitests.jetbrains.PairPickerAction" text="Pair with Piwi Picker"
                        description="Copy the address Piwi Picker sends locators and recorded steps to"/>
            </group>
            <separator/>
            <!--
              A run's controls use the debugger's own shortcuts, in every keymap (Pause Program's pauses, Resume
              Program's resumes, Step Over's steps, Run to Cursor's runs to the caret, Step Out's finishes): each is
              enabled only while it applies to a run Piwi started, and from the keyboard only while the debugger does
              not take the key (RunControlAction.givesWayTo). While a run is live they go first among the actions a
              keymap gives the same key (PiwiRunActionPromoter), and give way when they do not apply.
            -->
            <!-- One group for a run's controls, page, code actions, sharing and Stop, in this order wherever they show. -->
            <group id="Piwi.RunControl" text="Run control" compact="true">
            <action id="Piwi.PauseRun" class="dev.piwitests.jetbrains.PauseRunAction" text="Pause the run"
                    icon="AllIcons.Actions.Pause" use-shortcut-of="Pause"
                    description="Stop the tests of the run started from Piwi before their next call"/>
            <action id="Piwi.ResumeRun" class="dev.piwitests.jetbrains.ResumeRunAction" text="Resume the run"
                    icon="AllIcons.Actions.Resume" use-shortcut-of="Resume"
                    description="Run the stopped test on to the next breakpoint"/>
            <action id="Piwi.StepRun" class="dev.piwitests.jetbrains.StepRunAction" text="Step to the next call"
                    icon="AllIcons.Actions.TraceOver" use-shortcut-of="StepOver"
                    description="Run the stopped test's call and stop again before the next one"/>
            <action id="Piwi.RunToCaret" class="dev.piwitests.jetbrains.RunToCaretAction" text="Run to the caret"
                    icon="AllIcons.Actions.RunToCursor" use-shortcut-of="RunToCursor"
                    description="Run the stopped test on to the first call on the caret's line"/>
            <action id="Piwi.FinishRun" class="dev.piwitests.jetbrains.FinishRunAction" text="Finish the test"
                    icon="AllIcons.Actions.StepOut" use-shortcut-of="StepOut"
                    description="Run the stopped test on without stopping at a breakpoint again in this attempt"/>
            <!-- No shortcut: the debugger has no action it stands for. -->
            <action id="Piwi.EndTest" class="dev.piwitests.jetbrains.EndTestAction" text="End the test"
                    icon="AllIcons.RunConfigurations.TestIgnored"
                    description="End the stopped test there, reported as skipped: the rest of it never runs"/>
            <action id="Piwi.ShowPausedPage" class="dev.piwitests.jetbrains.ShowPausedPageAction" text="Show the paused page"
                    icon="AllIcons.Actions.Preview"
                    description="An image of the stopped test's page, in the Piwi tool window"/>
            <!-- Enabled while a worker's reporter shows its running test, with no shortcut. -->
            <action id="Piwi.WatchWorker" class="dev.piwitests.jetbrains.WatchWorkerAction" text="Watch a worker's test"
                    icon="AllIcons.Actions.Show"
                    description="The page of the test a worker runs, a few images a second, in the Piwi tool window"/>
            <action id="Piwi.PauseAndWatch" icon="/icons/pauseWatch.svg" class="dev.piwitests.jetbrains.PauseAndWatchAction"
                    text="Pause and watch a worker's test"
                    description="Stop a worker before its next call, and watch its page in the Piwi tool window"/>
            <action id="Piwi.OpenTraceSoFar" class="dev.piwitests.jetbrains.OpenTraceSoFarAction"
                    text="Open the trace so far" icon="AllIcons.FileTypes.Archive"
                    description="Open the trace of the test the Worker tab watches, as far as it ran, in Playwright's trace viewer"/>
            <!-- The code actions at a stop: enabled while a stop offers them, with no shortcut. -->
            <action id="Piwi.PickAtStop" class="dev.piwitests.jetbrains.PickAtStopAction" text="Pick a locator at the stop"
                    icon="AllIcons.General.Locate"
                    description="Pick an element in the stopped test's window: its locator replaces the one on the stopped line"/>
            <action id="Piwi.RecordAtStop" class="dev.piwitests.jetbrains.RecordAtStopAction" text="Record at the stop"
                    icon="AllIcons.Ide.Macro.Recording_1"
                    description="Record what you do in the stopped test's window above the stopped line"/>
            <action id="Piwi.AssertAtStop" class="dev.piwitests.jetbrains.AssertAtStopAction" text="Assert at the stop"
                    icon="AllIcons.General.InspectionsOK"
                    description="Check an element in the stopped test's window: the expect() goes above the stopped line"/>
            <action id="Piwi.AssertRegionAtStop" icon="/icons/region.svg" class="dev.piwitests.jetbrains.AssertRegionAtStopAction"
                    text="Assert a region at the stop"
                    description="Pick a region in the stopped test's window: its ARIA snapshot goes above the stopped line"/>
            <action id="Piwi.MockAtStop" icon="/icons/mock.svg" class="dev.piwitests.jetbrains.MockAtStopAction" text="Mock a request at the stop…"
                    description="Answer a request the stopped test made as the server did: page.route() goes above the stopped line"/>
            <action id="Piwi.ShowBrowser" icon="/icons/browser.svg" class="dev.piwitests.jetbrains.ShowBrowserAction"
                    text="Show the stopped test's browser"
                    description="Bring the stopped test's window to the front, at a stop of a headed run"/>
            <!-- Off until asked, each time, after a warning: a shared browser is open to any process of the user. -->
            <action id="Piwi.ShareWithPlaywright" icon="/icons/tools.svg" class="dev.piwitests.jetbrains.ShareWithPlaywrightAction"
                    text="Share the stopped test's browser with Playwright tools"
                    description="Until the test ends, let playwright-cli attach and Playwright's dashboard join the stopped test's browser"/>
            <!-- Asked with a warning the first time in the IDE's session: the run's pages go to the team instance. -->
            <action id="Piwi.ShareRunLive" icon="/icons/live.svg" class="dev.piwitests.jetbrains.ShareRunLiveAction" text="Share the run live on the team instance"
                    description="Let anyone who can open the run on your team's Piwi instance watch its tests' pages from the run page"/>
            <action id="Piwi.StopSharingRun" icon="/icons/stopLive.svg" class="dev.piwitests.jetbrains.StopSharingRunAction"
                    text="Stop sharing the run live"
                    description="End the views of the run on the team instance: nothing more goes there"/>
            <action id="Piwi.ShareWindowLive" icon="/icons/live.svg" class="dev.piwitests.jetbrains.ShareWindowLiveAction"
                    text="Share this project's runs live until I stop"
                    description="Share each run of this project live on your team's Piwi instance from now on, until you stop or close the project"/>
            <action id="Piwi.StopSharingWindowLive" icon="/icons/stopLive.svg" class="dev.piwitests.jetbrains.StopSharingWindowLiveAction"
                    text="Stop sharing this project's runs live"
                    description="Stop sharing every run of this project live: nothing more goes to the team instance"/>
            <action id="Piwi.HoldFailures" class="dev.piwitests.jetbrains.HoldFailuresAction" text="Turn hold failures on or off for the run"
                    icon="AllIcons.Debugger.Db_exception_breakpoint"
                    description="Whether a failed test no pause bar shows waits at its line for an answer in the run, whichever surface set it"/>
            <action id="Piwi.StopRun" class="dev.piwitests.jetbrains.StopRunAction" text="Stop the run"
                    icon="AllIcons.Actions.Suspend"
                    description="End the process of the run started from Piwi"/>
            </group>
            <separator/>
            <group id="Piwi.Dashboard" text="Dashboard" compact="true">
                <action id="Piwi.OpenInDashboard" class="dev.piwitests.jetbrains.OpenInDashboardAction"
                        icon="AllIcons.Ide.External_link_arrow"
                        text="Open in dashboard" description="Open this file's test, or the latest run"/>
                <action id="Piwi.OpenLatestRun" class="dev.piwitests.jetbrains.OpenLatestRunAction"
                        icon="AllIcons.General.Web"
                        text="Open the latest run" description="Open the run the status bar shows"/>
                <action id="Piwi.RefreshRun" class="dev.piwitests.jetbrains.RefreshRunAction" text="Refresh the latest run"
                        icon="AllIcons.Actions.Refresh"
                        description="Read the latest run and its failures again, not the indexes Reload Piwi fetches"/>
                <action id="Piwi.CompareWith" class="dev.piwitests.jetbrains.CompareWithAction" text="Compare with…"
                        icon="AllIcons.Actions.Diff"
                        description="Choose the run the failures are read against: a branch, a run, or your local runs only"/>
                <action id="Piwi.ToggleCoverageMarks" class="dev.piwitests.jetbrains.ToggleCoverageMarksAction"
                        text="Show coverage marks"
                        description="Mark the lines the tests ran, the executable lines none runs and the lines changed since the coverage run"/>
            </group>
            <separator/>
            <group id="Piwi.Agents" text="Agents" compact="true">
                <action id="Piwi.CopyMcpConfiguration" class="dev.piwitests.jetbrains.CopyMcpConfigurationAction"
                        text="Copy the MCP server configuration"
                        icon="AllIcons.Actions.Copy"
                        description="An mcpServers entry for the AI Assistant's MCP settings"/>
                <action id="Piwi.CopyRunsMcpConfiguration" class="dev.piwitests.jetbrains.CopyRunsMcpConfigurationAction"
                        text="Copy the runs' MCP server configuration for agents"
                        icon="AllIcons.Actions.Copy"
                        description="An mcpServers entry through mcp-remote, for the AI Assistant or another agent that starts commands, to follow, stop and act on the test runs this project starts"/>
                <action id="Piwi.CopyRunsMcpHttpConfiguration" class="dev.piwitests.jetbrains.CopyRunsMcpHttpConfigurationAction"
                        text="Copy the runs' MCP server configuration for Claude Code or Cursor"
                        icon="AllIcons.Actions.Copy"
                        description="An mcpServers entry of type http, with the token as a bearer header, for an agent that connects to it directly"/>
                <action id="Piwi.ResetRunsMcpToken" icon="/icons/key.svg" class="dev.piwitests.jetbrains.ResetRunsMcpTokenAction"
                        text="Reset the runs' MCP server token"
                        description="A new token for the runs' MCP server: every agent given the one before is refused"/>
            </group>
            <separator/>
            <group id="Piwi.Connection" text="Connection" compact="true">
                <action id="Piwi.Connect" class="dev.piwitests.jetbrains.ConnectAction" text="Connect…"
                        icon="/icons/connect.svg"
                        description="Choose the Piwi desktop app or an instance, sign in or paste an API key, and pick the project"/>
                <action id="Piwi.Disconnect" icon="/icons/disconnect.svg" class="dev.piwitests.jetbrains.DisconnectAction" text="Disconnect"
                        description="Forget this project's Piwi instance, project, the API key saved for it and the choice of the desktop app"/>
                <action id="Piwi.Refresh" class="dev.piwitests.jetbrains.RefreshAction" text="Reload Piwi"
                        icon="/icons/reload.svg"
                        description="Fetch the indexes and the latest run again, and start the editor service again when it stopped"/>
                <action id="Piwi.RestartService" class="dev.piwitests.jetbrains.RestartServiceAction"
                        text="Restart the editor service" icon="AllIcons.Actions.Restart"
                        description="Stop the Piwi editor service and start it again, or start it for the open test files when it does not run"/>
                <action id="Piwi.OpenLog" class="dev.piwitests.jetbrains.OpenLogAction" text="Open the log"
                        icon="AllIcons.Toolwindows.ToolWindowMessages"
                        description="The Piwi editor service's log: its starts and ends, its errors and the requests that failed"/>
                <action id="Piwi.OpenSettings" class="dev.piwitests.jetbrains.OpenSettingsAction" text="Open settings"
                        icon="AllIcons.General.Settings"
                        description="The Piwi instance and project of this project: Settings → Tools → Piwi"/>
                <action id="Piwi.OpenDocumentation" class="dev.piwitests.jetbrains.OpenDocumentationAction" text="Documentation"
                        icon="AllIcons.Actions.Help"
                        description="Open Piwi's documentation for the JetBrains IDEs in the browser"/>
            </group>
        </group>
        <!-- The status popup's own rows, registered so their keys show and Find Action reaches them. -->
        <group id="Piwi.StatusActions">
            <action id="Piwi.ShowStop" class="dev.piwitests.jetbrains.ShowStopAction" text="Go to the stopped line"
                    icon="AllIcons.Debugger.NextStatement" use-shortcut-of="ShowExecutionPoint"
                    description="Open the line a test of the run is stopped at"/>
            <action id="Piwi.OpenRunPage" class="dev.piwitests.jetbrains.OpenRunPageAction" text="Open the run page"
                    icon="AllIcons.General.Web" description="Open the page of the run started or followed here"/>
            <action id="Piwi.OpenFailures" class="dev.piwitests.jetbrains.OpenFailuresAction" text="Open the failures"
                    icon="/icons/piwi.svg" description="Open the Piwi tool window's failures"/>
            <action id="Piwi.ShowFlakyTests" class="dev.piwitests.jetbrains.ShowFlakyTestsAction" icon="/icons/testFlaky.svg"
                    text="Show the run's flaky tests" description="Open the Piwi tool window on the run's flaky tests"/>
            <action id="Piwi.NodeSettings" class="dev.piwitests.jetbrains.NodeSettingsAction" text="Node.js settings…"
                    icon="AllIcons.General.Settings" description="Choose the Node.js the editor service starts with"/>
            <action id="Piwi.GoToRecordedLines" class="dev.piwitests.jetbrains.GoToRecordedLinesAction"
                    text="Go to the recorded lines" icon="AllIcons.Actions.EditSource"
                    description="Open the lines the recording in progress writes"/>
        </group>
        <!-- The Piwi tool window's actions on its selected failure (`FAILURE_NODE`): its right-click menu, and Find Action. -->
        <group id="Piwi.FailureActions">
            <action id="Piwi.Failure.RunTest" class="dev.piwitests.jetbrains.RunFailureTestAction" text="Run this test"
                    description="Run the selected failure's test as Piwi runs it"/>
            <action id="Piwi.Failure.OpenTrace" class="dev.piwitests.jetbrains.OpenFailureTraceAction" text="Open the trace"
                    description="Open the selected failure's trace in Playwright's trace viewer">
                <synonym text="Playwright trace viewer"/>
            </action>
            <action id="Piwi.Failure.OpenScreenshot" class="dev.piwitests.jetbrains.OpenFailureScreenshotAction"
                    text="Open the screenshot" description="Open the selected failure's screenshot"/>
            <action id="Piwi.Failure.CopyContext" class="dev.piwitests.jetbrains.CopyFailureContextAction"
                    text="Copy context for agent" description="Copy the selected failure as an agent reads it"/>
            <action id="Piwi.Failure.Reproduce" class="dev.piwitests.jetbrains.ReproduceFailureAction"
                    text="Reproduce in the desktop app" description="Reproduce the selected CI failure on this machine, in the desktop app"/>
            <action id="Piwi.Failure.FindBreakingCommit" class="dev.piwitests.jetbrains.FindBreakingCommitAction"
                    text="Find the breaking commit in the desktop app"
                    description="Find the commit that broke the selected CI failure's test, in the desktop app"/>
        </group>
        <!--
          Piwi's entries in the editor's context menu: one Piwi submenu, the same sections in the same order as the VS
          Code extension's (run, record, a recording's controls), each entry shown only where it applies.
        -->
        <group id="Piwi.EditorPopup" class="dev.piwitests.jetbrains.PiwiEditorPopupGroup" text="Piwi" popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <reference ref="Piwi.RunTestAtCursor"/>
            <reference ref="Piwi.VerifyTestAtCursor"/>
            <reference ref="Piwi.RunSpec"/>
            <reference ref="Piwi.RunTestsForFile"/>
            <separator/>
            <reference ref="Piwi.RecordHere"/>
            <reference ref="Piwi.RecordNewFile"/>
            <separator/>
            <reference ref="Piwi.StopRecording"/>
            <reference ref="Piwi.PauseRecording"/>
            <reference ref="Piwi.ResumeRecording"/>
        </group>
        <!-- The project view's Piwi submenu on a file or a folder: run a spec, the tests that reach a file, record a new one. -->
        <group id="Piwi.ProjectViewPopup" class="dev.piwitests.jetbrains.PiwiEditorPopupGroup" text="Piwi" popup="true">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <reference ref="Piwi.RunSpec"/>
            <reference ref="Piwi.RunTestsForFile"/>
            <separator/>
            <reference ref="Piwi.RecordNewFile"/>
        </group>
        <action id="Piwi.RecordHereGenerate" class="dev.piwitests.jetbrains.RecordHereGenerateAction" text="Piwi: Record here…"
                icon="AllIcons.Ide.Macro.Recording_1"
                description="Open a browser with the project's Playwright and write what you do there at the caret: steps of the test, method or function it is in, else a new test">
            <add-to-group group-id="GenerateGroup" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
