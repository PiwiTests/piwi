    "menus": {
      "commandPalette": [
        {
          "command": "piwi.runTests",
          "when": "false"
        },
        {
          "command": "piwi.openTrace",
          "when": "false"
        },
        {
          "command": "piwi.openScreenshot",
          "when": "false"
        },
        {
          "command": "piwi.runCommand",
          "when": "false"
        },
        {
          "command": "piwi.copyText",
          "when": "false"
        },
        {
          "command": "piwi.desktopJob",
          "when": "false"
        },
        {
          "command": "piwi.runTest",
          "when": "false"
        },
        {
          "command": "piwi.copyAgentContext",
          "when": "false"
        },
        {
          "command": "piwi.reproduceInDesktop",
          "when": "false"
        },
        {
          "command": "piwi.bisectInDesktop",
          "when": "false"
        },
        {
          "command": "piwi.toggleFollowEditor",
          "when": "!piwi.followEditor"
        },
        {
          "command": "piwi.stopFollowingEditor",
          "when": "piwi.followEditor"
        },
        {
          "command": "piwi.toggleCoverage",
          "when": "piwi.hasCoverage"
        },
        {
          "command": "piwi.runTestAtCursor",
          "when": "resourceFilename =~ /\\.(spec|test)\\.[cm]?[jt]sx?$/"
        },
        {
          "command": "piwi.verifyTestAtCursor",
          "when": "resourceFilename =~ /\\.(spec|test)\\.[cm]?[jt]sx?$/"
        },
        {
          "command": "piwi.runSpec",
          "when": "piwi.active && resourceFilename =~ /\\.(spec|test)\\.[cm]?[jt]sx?$/"
        },
        {
          "command": "piwi.record",
          "when": "editorLangId =~ /^(typescript|javascript)(react)?$/"
        },
        {
          "command": "piwi.stopRecording",
          "when": "piwi.recording"
        },
        {
          "command": "piwi.pauseRecording",
          "when": "piwi.recording && !piwi.recordingPaused"
        },
        {
          "command": "piwi.resumeRecording",
          "when": "piwi.recordingPaused"
        }
      ],
      "editor/context": [
        {
          "command": "piwi.runTestAtCursor",
          "group": "piwi@1",
          "when": "resourceFilename =~ /\\.(spec|test)\\.[cm]?[jt]sx?$/"
        },
        {
          "command": "piwi.verifyTestAtCursor",
          "group": "piwi@1",
          "when": "resourceFilename =~ /\\.(spec|test)\\.[cm]?[jt]sx?$/"
        },
        {
          "command": "piwi.runSpec",
          "group": "piwi@1",
          "when": "piwi.active && resourceFilename =~ /\\.(spec|test)\\.[cm]?[jt]sx?$/"
        },
        {
          "command": "piwi.runTestsForFile",
          "group": "piwi@1",
          "when": "piwi.active"
        },
        {
          "command": "piwi.record",
          "group": "piwi@2",
          "when": "editorLangId =~ /^(typescript|javascript)(react)?$/ && !piwi.recording"
        },
        {
          "command": "piwi.recordFile",
          "group": "piwi@3",
          "when": "editorLangId =~ /^(typescript|javascript)(react)?$/ && !piwi.recording"
        },
        {
          "command": "piwi.stopRecording",
          "group": "piwi@2",
          "when": "editorLangId =~ /^(typescript|javascript)(react)?$/ && piwi.recording"
        },
        {
          "command": "piwi.pauseRecording",
          "group": "piwi@3",
          "when": "editorLangId =~ /^(typescript|javascript)(react)?$/ && piwi.recording && !piwi.recordingPaused"
        },
        {
          "command": "piwi.resumeRecording",
          "group": "piwi@3",
          "when": "editorLangId =~ /^(typescript|javascript)(react)?$/ && piwi.recordingPaused"
        }
      ],
      "view/title": [
        {
          "command": "piwi.refreshRun",
          "when": "view == piwi.failures",
          "group": "navigation@1"
        },
        {
          "command": "piwi.rerunFailing",
          "when": "view == piwi.failures",
          "group": "navigation@2"
        },
        {
          "command": "piwi.openRun",
          "when": "view == piwi.failures",
          "group": "navigation@3"
        },
        {
          "command": "piwi.compareWith",
          "when": "view == piwi.failures",
          "group": "navigation@4"
        },
        {
          "command": "piwi.groupFailuresBy",
          "when": "view == piwi.failures",
          "group": "navigation@5"
        },
        {
          "command": "piwi.toggleFollowEditor",
          "when": "view == piwi.failures && !piwi.followEditor",
          "group": "navigation@6"
        },
        {
          "command": "piwi.stopFollowingEditor",
          "when": "view == piwi.failures && piwi.followEditor",
          "group": "navigation@6"
        }
      ],
      "view/item/context": [
        {
          "command": "piwi.runTest",
          "when": "view == piwi.failures && viewItem =~ /^piwi\\.failure\\./",
          "group": "inline@1"
        },
        {
          "command": "piwi.openTrace",
          "when": "view == piwi.failures && viewItem =~ /^piwi\\.failure\\..*\\btrace\\b/",
          "group": "inline@2"
        },
        {
          "command": "piwi.openInDashboard",
          "when": "view == piwi.failures && viewItem =~ /^piwi\\.failure\\./",
          "group": "inline@3"
        },
        {
          "command": "piwi.openInDashboard",
          "when": "view == piwi.failures && viewItem =~ /^piwi\\.(run|overlay)$/",
          "group": "inline@1"
        },
        {
          "command": "piwi.rerunFailing",
          "when": "view == piwi.failures && viewItem =~ /^piwi\\.context\\..*\\bfailing\\b/",
          "group": "inline@1"
        },
        {
          "command": "piwi.openInDashboard",
          "when": "view == piwi.failures && viewItem =~ /^piwi\\.context\\..*\\brun\\b/",
          "group": "inline@2"
        },
        {
          "command": "piwi.rerunFailing",
          "when": "view == piwi.failures && viewItem =~ /^piwi\\.context\\..*\\bfailing\\b/",
          "group": "1_run@1"
        },
        {
          "command": "piwi.compareWith",
          "when": "view == piwi.failures && viewItem =~ /^piwi\\.(context\\b|run$)/",
          "group": "2_baseline@1"
        },
        {
          "command": "piwi.openInDashboard",
          "when": "view == piwi.failures && viewItem =~ /^piwi\\.context\\..*\\brun\\b/",
          "group": "3_open@1"
        },
        {
          "command": "piwi.runTest",
          "when": "view == piwi.failures && viewItem =~ /^piwi\\.failure\\./",
          "group": "1_run@1"
        },
        {
          "command": "piwi.openTrace",
          "when": "view == piwi.failures && viewItem =~ /^piwi\\.failure\\..*\\btrace\\b/",
          "group": "2_evidence@1"
        },
        {
          "command": "piwi.openScreenshot",
          "when": "view == piwi.failures && viewItem =~ /^piwi\\.failure\\..*\\bscreenshot\\b/",
          "group": "2_evidence@2"
        },
        {
          "command": "piwi.openInDashboard",
          "when": "view == piwi.failures && viewItem =~ /^piwi\\.failure\\./",
          "group": "2_evidence@3"
        },
        {
          "command": "piwi.copyAgentContext",
          "when": "view == piwi.failures && viewItem =~ /^piwi\\.failure\\..*\\bagent\\b/",
          "group": "3_agent@1"
        },
        {
          "command": "piwi.reproduceInDesktop",
          "when": "view == piwi.failures && viewItem =~ /^piwi\\.failure\\..*\\bdesktop\\b/",
          "group": "4_desktop@1"
        },
        {
          "command": "piwi.bisectInDesktop",
          "when": "view == piwi.failures && viewItem =~ /^piwi\\.failure\\..*\\bdesktop\\b/",
          "group": "4_desktop@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "piwi.record",
        "key": "ctrl+shift+alt+r",
        "mac": "cmd+shift+alt+r",
        "when": "editorTextFocus && !piwi.recording && editorLangId =~ /^(typescript|javascript)(react)?$/"
      },
      {
        "command": "piwi.stopRecording",
        "key": "ctrl+shift+alt+r",
        "mac": "cmd+shift+alt+r",
        "when": "piwi.recording"
      },
      {
        "command": "piwi.rerunFailing",
        "key": "ctrl+shift+alt+f",
        "mac": "cmd+shift+alt+f"
      },
      {
        "command": "piwi.runTestAtCursor",
        "key": "ctrl+shift+alt+k",
        "mac": "cmd+shift+alt+k",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Piwi",
      "properties": {
        "piwi.serverUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "The Piwi instance. `PIWI_DASHBOARD_URL` in the environment or the workspace `.env` comes first; then this setting; then the Piwi desktop app while it runs. Run **Piwi: Connect** to sign in with the browser: the API key goes to the editor's secret storage, saved for this instance only. Choosing the desktop app with **Piwi: Connect** puts it first while it runs, on this machine only, and keeps this setting for when it does not."
        },
        "piwi.project": {
          "type": "string",
          "default": "",
          "description": "The project's name or id on the instance. The desktop app's project is the one picked with Piwi: Connect, else the one linked there to this folder."
        },
        "piwi.breakpoints": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Pause the runs Piwi starts at the editor's breakpoints, in the browser, with the picker. A run with a breakpoint in a test or page object file runs headed and pauses before the call on that line that acts on, reads or checks the page (a navigation, a click, a key press, an assertion), with Piwi's pause bar: **Resume**, **Step**, **Pick a locator**, **Finish**. A locator picked there replaces the one on the breakpoint's line. Needs `@piwitests/reporter` 0.48.0 or later, and 0.60.0 or later to pause before calls other than locator actions and assertions."
        },
        "piwi.runNotifications": {
          "type": "string",
          "enum": [
            "always",
            "failures",
            "never"
          ],
          "enumDescriptions": [
            "Say what every run started from the editor changed, once it ends.",
            "Only when the run failed a test.",
            "Never: the status bar, the gutter and the failures view still show it."
          ],
          "default": "always",
          "description": "When a run started from the editor ends, a notification says what it changed: the failures it fixed, those still failing, and its new failures."
        },
        "piwi.failureSeverity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "off"
          ],
          "enumDescriptions": [
            "An error, in the Problems panel and on the line.",
            "A warning.",
            "An information.",
            "None: the failures view, the gutter and the lines above the tests still show it."
          ],
          "default": "error",
          "markdownDescription": "How a failure of the latest run shows at its line in the editor and the Problems panel. A failure of a run on another branch, such as the default branch's while yours has no run, is a warning at most; one whose line you changed since the run, an information."
        },
        "piwi.mcpAuthorization": {
          "type": "string",
          "scope": "application",
          "enum": [
            "key",
            "sign-in"
          ],
          "enumDescriptions": [
            "The agent uses the editor's API key, with your role and project access.",
            "The agent signs in through the instance's OAuth, the first time it connects, for a token of its own that you can revoke in Settings → Account → API keys."
          ],
          "default": "key",
          "markdownDescription": "How the editor's agent signs in to Piwi's MCP server, as the extension provides it and as **Piwi: Copy the MCP server configuration** writes it. The desktop app's server takes its own token either way."
        },
        "piwi.testExplorer": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "List Piwi's tests in the Testing view: the specs your instance knows, as they stand, each test with its latest result, where and why it failed, and the run in progress as it goes. The Testing view's gutter then shows each test's result in place of Piwi's own icon, and **Run with Piwi** and **Verify ×3 with Piwi** run tests as every other run Piwi starts. Results only: it neither discovers tests nor debugs them."
        },
        "piwi.trace.server": {
          "type": "string",
          "scope": "window",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "enumDescriptions": [
            "Nothing.",
            "Each request, answer and notification.",
            "Each one with its contents."
          ],
          "default": "off",
          "description": "Traces the traffic with the Piwi editor service in the Piwi output channel, which Piwi: Open the log shows."
        }
      }
    },
    "colors": [
      {
        "id": "piwi.failingTestBackground",
        "description": "The background of a test that failed in the latest run Piwi reads.",
        "defaults": {
          "dark": "#f8514926",
          "light": "#f851491a",
          "highContrast": "#f8514940",
          "highContrastLight": "#f8514926"
        }
      },
      {
        "id": "piwi.failingLineBackground",
        "description": "The background of the line a failing test failed at, over the test's own.",
        "defaults": {
          "dark": "#f8514940",
          "light": "#f8514933",
          "highContrast": "#f8514966",
          "highContrastLight": "#f8514940"
        }
      },
      {
        "id": "piwi.coverageRunBorder",
        "description": "The mark at the left of a line the tests ran, in the coverage Piwi shows: the color the dashboard marks it in.",
        "defaults": {
          "dark": "#14b8a6",
          "light": "#0d9488",
          "highContrast": "#14b8a6",
          "highContrastLight": "#0d9488"
        }
      },
      {
        "id": "piwi.coverageNotRunBorder",
        "description": "The mark at the left of an executable line no test runs, in the coverage Piwi shows: the color the dashboard marks it in.",
        "defaults": {
          "dark": "#64748b",
          "light": "#94a3b8",
          "highContrast": "#64748b",
          "highContrastLight": "#94a3b8"
        }
      },
      {
        "id": "piwi.coverageChangedBorder",
        "description": "The mark at the left of a line changed since the coverage run Piwi shows: what runs it is not known until a run records it again.",
        "defaults": {
          "dark": "#d29922",
          "light": "#9a6700",
          "highContrast": "#e3b341",
          "highContrastLight": "#7d4e00"
        }
      },
      {
        "id": "piwi.uncoveredChangeBorder",
        "description": "The mark at the left of a line changed since the default branch, in a file no test reaches: an uncovered change, which the pull request's change coverage lists.",
        "defaults": {
          "dark": "#f0883e",
          "light": "#bc4c00",
          "highContrast": "#ffa657",
          "highContrastLight": "#953800"
        }
      },
      {
        "id": "piwi.recordingBlockBackground",
        "description": "The background of the block a recording writes, while it records.",
        "defaults": {
          "dark": "#2f81f726",
          "light": "#0969da1a",
          "highContrast": "#2f81f740",
          "highContrastLight": "#0969da26"
        }
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "piwi.mcp",
        "label": "Piwi"
      }
    ],
    "taskDefinitions": [
      {
        "type": "piwi",
        "required": [
          "ref"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "description": "The ref of the test run: the `PIWI_ORIGIN_REF` its command sets, by which Piwi follows the run."
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:build": "npm run editor:build -w @piwitests/editor && node build.mjs",
    "vscode:typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "vscode:lint": "oxlint --config oxlint.config.mts .",
    "vscode:lint:fix": "oxlint --config oxlint.config.mts . --fix",
    "vscode:format": "oxfmt --config oxfmt.config.mts --write \"src/\" \"tests/\" \"scripts/\" build.mjs",
    "vscode:format:check": "oxfmt --config oxfmt.config.mts --check \"src/\" \"tests/\" \"scripts/\" build.mjs",
    "vscode:test": "vitest run",
    "vscode:test:integration": "npm run vscode:build && node tests/integration/run.mjs",
    "vscode:test:e2e": "playwright test --config tests/e2e/playwright.config.mjs",
    "vscode:package": "npm run vscode:build && vsce package --no-dependencies --out dist/piwi.vsix",
    "test": "npm run vscode:test"
  },
  "devDependencies": {
    "@piwitests/core": "*",
    "@piwitests/editor": "*",
    "@playwright/test": "^1.64.1",
    "@types/vscode": "~1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.3.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "vscode-languageclient": "^10.1.2"
  }
}
