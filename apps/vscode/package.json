{
  "name": "piwi",
  "displayName": "Piwi",
  "description": "Your Playwright suite's history in the editor: CI failures at their lines, healing in place, the tests behind each locator and file, and the locators a change breaks",
  "version": "0.51.0",
  "publisher": "piwitests",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "icon": "icon.png",
  "homepage": "https://piwitests.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/PiwiTests/platform",
    "directory": "apps/vscode"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Testing",
    "Linters"
  ],
  "keywords": [
    "playwright",
    "e2e",
    "locators",
    "flaky tests",
    "test history"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "workspaceContains:**/playwright.config.{ts,js,mjs,cjs}"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "piwi",
          "title": "Piwi",
          "icon": "media/piwi.svg"
        }
      ]
    },
    "views": {
      "piwi": [
        {
          "id": "piwi.failures",
          "name": "Failures"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "piwi.failures",
        "contents": "Piwi is not connected to an instance, so it has no run to show.\n[Connect](command:piwi.connect)",
        "when": "piwi.failuresView == disconnected"
      },
      {
        "view": "piwi.failures",
        "contents": "No failure in the latest run of this branch: nothing to fix, and nothing your runs since broke.\n[Refresh](command:piwi.refreshRun)",
        "when": "piwi.failuresView == clear"
      },
      {
        "view": "piwi.failures",
        "contents": "The Piwi editor service is not answering. It starts with the first file of a Playwright workspace opened; refresh once it runs.\n[Refresh](command:piwi.refresh)",
        "when": "piwi.failuresView == unavailable"
      }
    ],
    "commands": [
      {
        "command": "piwi.connect",
        "title": "Connect",
        "category": "Piwi"
      },
      {
        "command": "piwi.disconnect",
        "title": "Disconnect",
        "category": "Piwi"
      },
      {
        "command": "piwi.openSettings",
        "title": "Open settings",
        "category": "Piwi"
      },
      {
        "command": "piwi.refresh",
        "title": "Refresh",
        "category": "Piwi"
      },
      {
        "command": "piwi.refreshRun",
        "title": "Refresh the latest run",
        "category": "Piwi",
        "icon": "$(refresh)"
      },
      {
        "command": "piwi.runTestsForFile",
        "title": "Run the tests that reach this file",
        "category": "Piwi"
      },
      {
        "command": "piwi.runSelection",
        "title": "Run selection…",
        "category": "Piwi"
      },
      {
        "command": "piwi.openInDashboard",
        "title": "Open in dashboard",
        "category": "Piwi",
        "icon": "$(globe)"
      },
      {
        "command": "piwi.openRun",
        "title": "Open the latest run",
        "category": "Piwi",
        "icon": "$(globe)"
      },
      {
        "command": "piwi.copyMcpConfiguration",
        "title": "Copy the MCP server configuration",
        "category": "Piwi"
      },
      {
        "command": "piwi.pairPicker",
        "title": "Pair with Piwi Picker",
        "category": "Piwi"
      },
      {
        "command": "piwi.runTests",
        "title": "Run tests",
        "category": "Piwi"
      },
      {
        "command": "piwi.runTest",
        "title": "Run this test",
        "category": "Piwi",
        "icon": "$(play)"
      },
      {
        "command": "piwi.rerunFailing",
        "title": "Re-run the failing tests",
        "category": "Piwi",
        "icon": "$(run-all)"
      },
      {
        "command": "piwi.groupFailuresBy",
        "title": "Group the failures by…",
        "category": "Piwi",
        "icon": "$(list-tree)"
      },
      {
        "command": "piwi.compareWith",
        "title": "Compare with…",
        "category": "Piwi",
        "icon": "$(git-compare)"
      },
      {
        "command": "piwi.toggleFollowEditor",
        "title": "Follow the active editor",
        "category": "Piwi",
        "icon": "$(eye-closed)"
      },
      {
        "command": "piwi.stopFollowingEditor",
        "title": "Stop following the active editor",
        "category": "Piwi",
        "icon": "$(eye)"
      },
      {
        "command": "piwi.copyAgentContext",
        "title": "Copy context for agent",
        "category": "Piwi"
      },
      {
        "command": "piwi.reproduceInDesktop",
        "title": "Reproduce in the desktop app",
        "category": "Piwi"
      },
      {
        "command": "piwi.bisectInDesktop",
        "title": "Find the breaking commit in the desktop app",
        "category": "Piwi"
      },
      {
        "command": "piwi.openTrace",
        "title": "Open the trace",
        "category": "Piwi",
        "icon": "$(file-zip)"
      },
      {
        "command": "piwi.openScreenshot",
        "title": "Open the failure screenshot",
        "category": "Piwi",
        "icon": "$(file-media)"
      },
      {
        "command": "piwi.runCommand",
        "title": "Run a command",
        "category": "Piwi"
      },
      {
        "command": "piwi.copyText",
        "title": "Copy text",
        "category": "Piwi"
      },
      {
        "command": "piwi.desktopJob",
        "title": "Reproduce, bisect or run Flake Lab in the desktop app",
        "category": "Piwi"
      },
      {
        "command": "piwi.record",
        "title": "Record here",
        "category": "Piwi"
      },
      {
        "command": "piwi.recordFile",
        "title": "Record a new test file",
        "category": "Piwi"
      },
      {
        "command": "piwi.stopRecording",
        "title": "Stop recording",
        "category": "Piwi"
      },
      {
        "command": "piwi.pauseRecording",
        "title": "Pause recording",
        "category": "Piwi"
      },
      {
        "command": "piwi.resumeRecording",
        "title": "Resume recording",
        "category": "Piwi"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "piwi.runTests",
          "when": "false"
        },
        {
          "command": "piwi.openTrace",
          "when": "false"
        },
        {
          "command": "piwi.openScreenshot",
          "when": "false"
        },
        {
          "command": "piwi.runCommand",
          "when": "false"
        },
        {
          "command": "piwi.copyText",
          "when": "false"
        },
        {
          "command": "piwi.desktopJob",
          "when": "false"
        },
        {
          "command": "piwi.runTest",
          "when": "false"
        },
        {
          "command": "piwi.copyAgentContext",
          "when": "false"
        },
        {
          "command": "piwi.reproduceInDesktop",
          "when": "false"
        },
        {
          "command": "piwi.bisectInDesktop",
          "when": "false"
        },
        {
          "command": "piwi.toggleFollowEditor",
          "when": "!piwi.followEditor"
        },
        {
          "command": "piwi.stopFollowingEditor",
          "when": "piwi.followEditor"
        },
        {
          "command": "piwi.record",
          "when": "editorLangId =~ /^(typescript|javascript)(react)?$/"
        },
        {
          "command": "piwi.stopRecording",
          "when": "piwi.recording"
        },
        {
          "command": "piwi.pauseRecording",
          "when": "piwi.recording && !piwi.recordingPaused"
        },
        {
          "command": "piwi.resumeRecording",
          "when": "piwi.recordingPaused"
        }
      ],
      "editor/context": [
        {
          "command": "piwi.runTestsForFile",
          "group": "piwi@1",
          "when": "piwi.active"
        },
        {
          "command": "piwi.record",
          "group": "piwi@2",
          "when": "editorLangId =~ /^(typescript|javascript)(react)?$/ && !piwi.recording"
        },
        {
          "command": "piwi.recordFile",
          "group": "piwi@3",
          "when": "editorLangId =~ /^(typescript|javascript)(react)?$/ && !piwi.recording"
        },
        {
          "command": "piwi.stopRecording",
          "group": "piwi@2",
          "when": "editorLangId =~ /^(typescript|javascript)(react)?$/ && piwi.recording"
        },
        {
          "command": "piwi.pauseRecording",
          "group": "piwi@3",
          "when": "editorLangId =~ /^(typescript|javascript)(react)?$/ && piwi.recording && !piwi.recordingPaused"
        },
        {
          "command": "piwi.resumeRecording",
          "group": "piwi@3",
          "when": "editorLangId =~ /^(typescript|javascript)(react)?$/ && piwi.recordingPaused"
        }
      ],
      "view/title": [
        {
          "command": "piwi.refreshRun",
          "when": "view == piwi.failures",
          "group": "navigation@1"
        },
        {
          "command": "piwi.rerunFailing",
          "when": "view == piwi.failures",
          "group": "navigation@2"
        },
        {
          "command": "piwi.openRun",
          "when": "view == piwi.failures",
          "group": "navigation@3"
        },
        {
          "command": "piwi.compareWith",
          "when": "view == piwi.failures",
          "group": "navigation@4"
        },
        {
          "command": "piwi.groupFailuresBy",
          "when": "view == piwi.failures",
          "group": "navigation@5"
        },
        {
          "command": "piwi.toggleFollowEditor",
          "when": "view == piwi.failures && !piwi.followEditor",
          "group": "navigation@6"
        },
        {
          "command": "piwi.stopFollowingEditor",
          "when": "view == piwi.failures && piwi.followEditor",
          "group": "navigation@6"
        }
      ],
      "view/item/context": [
        {
          "command": "piwi.runTest",
          "when": "view == piwi.failures && viewItem =~ /^piwi\\.failure\\./",
          "group": "inline@1"
        },
        {
          "command": "piwi.openTrace",
          "when": "view == piwi.failures && viewItem =~ /^piwi\\.failure\\..*\\btrace\\b/",
          "group": "inline@2"
        },
        {
          "command": "piwi.openInDashboard",
          "when": "view == piwi.failures && viewItem =~ /^piwi\\.failure\\./",
          "group": "inline@3"
        },
        {
          "command": "piwi.openInDashboard",
          "when": "view == piwi.failures && viewItem =~ /^piwi\\.(run|overlay)$/",
          "group": "inline@1"
        },
        {
          "command": "piwi.runTest",
          "when": "view == piwi.failures && viewItem =~ /^piwi\\.failure\\./",
          "group": "1_run@1"
        },
        {
          "command": "piwi.openTrace",
          "when": "view == piwi.failures && viewItem =~ /^piwi\\.failure\\..*\\btrace\\b/",
          "group": "2_evidence@1"
        },
        {
          "command": "piwi.openScreenshot",
          "when": "view == piwi.failures && viewItem =~ /^piwi\\.failure\\..*\\bscreenshot\\b/",
          "group": "2_evidence@2"
        },
        {
          "command": "piwi.openInDashboard",
          "when": "view == piwi.failures && viewItem =~ /^piwi\\.failure\\./",
          "group": "2_evidence@3"
        },
        {
          "command": "piwi.copyAgentContext",
          "when": "view == piwi.failures && viewItem =~ /^piwi\\.failure\\..*\\bagent\\b/",
          "group": "3_agent@1"
        },
        {
          "command": "piwi.reproduceInDesktop",
          "when": "view == piwi.failures && viewItem =~ /^piwi\\.failure\\..*\\bdesktop\\b/",
          "group": "4_desktop@1"
        },
        {
          "command": "piwi.bisectInDesktop",
          "when": "view == piwi.failures && viewItem =~ /^piwi\\.failure\\..*\\bdesktop\\b/",
          "group": "4_desktop@2"
        }
      ]
    },
    "configuration": {
      "title": "Piwi",
      "properties": {
        "piwi.serverUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "The Piwi instance. `PIWI_DASHBOARD_URL` in the environment or the workspace `.env` comes first; then this setting; then the Piwi desktop app while it runs. Run **Piwi: Connect** to sign in with the browser: the API key goes to the editor's secret storage, saved for this instance only. Choosing the desktop app with **Piwi: Connect** puts it first while it runs, on this machine only, and keeps this setting for when it does not."
        },
        "piwi.project": {
          "type": "string",
          "default": "",
          "description": "The project's name or id on the instance. The desktop app's project is the one picked with Piwi: Connect, else the one linked there to this folder."
        },
        "piwi.breakpoints": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Pause the runs Piwi starts at the editor's breakpoints, in the browser, with the picker. A run with a breakpoint in a test or page object file runs headed and pauses before the locator action or assertion on that line, with Piwi's pause bar: **Resume**, **Step**, **Pick a locator**, **Finish**. A locator picked there replaces the one on the breakpoint's line. Needs `@piwitests/reporter` 0.48.0 or later."
        },
        "piwi.runNotifications": {
          "type": "string",
          "enum": [
            "always",
            "failures",
            "never"
          ],
          "enumDescriptions": [
            "Say what every run started from the editor changed, once it ends.",
            "Only when the run failed a test.",
            "Never: the status bar, the gutter and the failures view still show it."
          ],
          "default": "always",
          "description": "When a run started from the editor ends, a notification says what it changed: the failures it fixed, those still failing, and its new failures."
        }
      }
    },
    "colors": [
      {
        "id": "piwi.failingTestBackground",
        "description": "The background of a test that failed in the latest run Piwi reads.",
        "defaults": {
          "dark": "#f8514926",
          "light": "#f851491a",
          "highContrast": "#f8514940",
          "highContrastLight": "#f8514926"
        }
      },
      {
        "id": "piwi.failingLineBackground",
        "description": "The background of the line a failing test failed at, over the test's own.",
        "defaults": {
          "dark": "#f8514940",
          "light": "#f8514933",
          "highContrast": "#f8514966",
          "highContrastLight": "#f8514940"
        }
      },
      {
        "id": "piwi.recordingBlockBackground",
        "description": "The background of the block a recording writes, while it records.",
        "defaults": {
          "dark": "#2f81f726",
          "light": "#0969da1a",
          "highContrast": "#2f81f740",
          "highContrastLight": "#0969da26"
        }
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "piwi.mcp",
        "label": "Piwi"
      }
    ]
  },
  "scripts": {
    "vscode:build": "npm run editor:build -w @piwitests/editor && node build.mjs",
    "vscode:typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "vscode:lint": "oxlint --config oxlint.config.mts .",
    "vscode:lint:fix": "oxlint --config oxlint.config.mts . --fix",
    "vscode:format": "oxfmt --config oxfmt.config.mts --write \"src/\" \"tests/\" build.mjs",
    "vscode:format:check": "oxfmt --config oxfmt.config.mts --check \"src/\" \"tests/\" build.mjs",
    "vscode:test": "vitest run",
    "vscode:test:integration": "npm run vscode:build && node tests/integration/run.mjs",
    "vscode:package": "npm run vscode:build && vsce package --no-dependencies --out dist/piwi.vsix",
    "test": "npm run vscode:test"
  },
  "devDependencies": {
    "@piwitests/editor": "*",
    "@types/vscode": "~1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "ovsx": "^1.2.0",
    "vscode-languageclient": "^10.1.2"
  }
}
