{
  "name": "piwi",
  "displayName": "Piwi",
  "description": "Your Playwright suite's history in the editor: CI failures at their lines, healing in place, the tests behind each locator and file, and the locators a change breaks",
  "version": "0.60.0",
  "publisher": "piwitests",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "icon": "icon.png",
  "homepage": "https://piwitests.dev",
  "bugs": {
    "url": "https://github.com/PiwiTests/piwi/issues"
  },
  "qna": "https://github.com/PiwiTests/piwi/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/PiwiTests/piwi",
    "directory": "apps/vscode"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The Piwi editor service reads the workspace's files from disk and runs its Playwright."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "The Piwi editor service reads the files from disk and runs Playwright; a virtual workspace has neither."
    }
  },
  "categories": [
    "Testing",
    "Linters"
  ],
  "keywords": [
    "playwright",
    "e2e",
    "locators",
    "flaky tests",
    "test history",
    "coverage"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "workspaceContains:**/playwright.config.{ts,js,mjs,cjs,mts,cts}",
    "onUri"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "piwi",
          "title": "Piwi",
          "icon": "media/piwi.svg"
        }
      ]
    },
    "views": {
      "piwi": [
        {
          "id": "piwi.failures",
          "name": "Failures"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "piwi.failures",
        "contents": "Piwi is not connected to an instance, so it has no run to show.\n[Connect](command:piwi.connect)",
        "when": "piwi.failuresView == disconnected"
      },
      {
        "view": "piwi.failures",
        "contents": "No failure in the latest run of this branch: nothing to fix, and nothing your runs since broke.\n[Refresh](command:piwi.refreshRun)",
        "when": "piwi.failuresView == clear"
      },
      {
        "view": "piwi.failures",
        "contents": "The Piwi editor service is not answering. It starts with the extension, on a workspace that holds a Playwright config; Refresh asks it again, and the log says what it did.\n[Refresh](command:piwi.refresh)\n[Open the log](command:piwi.openLog)",
        "when": "piwi.failuresView == unavailable"
      }
    ],
    "walkthroughs": [
      {
        "id": "getStarted",
        "title": "Get started with Piwi",
        "description": "Connect to your Piwi instance, see the latest CI failures, run and record tests, and give your agent Piwi's MCP server.",
        "steps": [
          {
            "id": "connect",
            "title": "Connect to your Piwi instance",
            "description": "Piwi reads your suite's runs from your team's instance, or from the desktop app on this machine. A workspace set up for the reporter is connected already.\n[Connect](command:piwi.connect)",
            "media": {
              "markdown": "walkthrough/connect.md"
            },
            "completionEvents": [
              "onContext:piwi.active"
            ]
          },
          {
            "id": "failures",
            "title": "See the failures of the latest CI run",
            "description": "The Failures view lists the failures of the latest CI run on your branch, with your local runs since. Each one is also in the Problems panel, at the line that failed.\n[Open the failures](command:piwi.failures.focus)",
            "media": {
              "markdown": "walkthrough/failures.md"
            },
            "completionEvents": [
              "onView:piwi.failures"
            ]
          },
          {
            "id": "run",
            "title": "Run the failing tests",
            "description": "Re-run every test still failing, or, in a spec, run the test at the cursor with `Ctrl+Shift+Alt+K` (`Cmd+Shift+Alt+K` on macOS). When the run ends, the failures show what it fixed.\n[Re-run the failing tests](command:piwi.rerunFailing)",
            "media": {
              "markdown": "walkthrough/run.md"
            },
            "completionEvents": [
              "onCommand:piwi.rerunFailing",
              "onCommand:piwi.runTestAtCursor",
              "onCommand:piwi.verifyTestAtCursor",
              "onCommand:piwi.runSpec",
              "onCommand:piwi.runTest"
            ]
          },
          {
            "id": "record",
            "title": "Record a test",
            "description": "Piwi opens a browser with your project's Playwright and writes what you do there into a new spec. In a spec, `Ctrl+Shift+Alt+R` (`Cmd+Shift+Alt+R` on macOS) records at the cursor. No instance needed.\n[Record a new test file](command:piwi.recordFile)",
            "media": {
              "markdown": "walkthrough/record.md"
            },
            "completionEvents": [
              "onCommand:piwi.recordFile",
              "onCommand:piwi.record"
            ]
          },
          {
            "id": "mcp",
            "title": "Give your agent Piwi's MCP server",
            "description": "Your agent can read the suite's failures, flaky tests and healings. VS Code 1.101 and later lists the server for it with your connection; in another editor, copy its configuration.\n[Copy the MCP server configuration](command:piwi.copyMcpConfiguration)",
            "media": {
              "markdown": "walkthrough/mcp.md"
            },
            "completionEvents": [
              "onCommand:piwi.copyMcpConfiguration"
            ]
          },
          {
            "id": "settings",
            "title": "Open the settings",
            "description": "Choose how a CI failure shows in the Problems panel, when a run started from the editor says what it changed, and whether runs pause at your breakpoints.\n[Open settings](command:piwi.openSettings)",
            "media": {
              "markdown": "walkthrough/settings.md"
            },
            "completionEvents": [
              "onCommand:piwi.openSettings"
            ]
          }
        ]
      }
    ],
