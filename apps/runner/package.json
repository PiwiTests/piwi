{
  "name": "@piwitests/runner",
  "version": "0.68.0",
  "private": true,
  "description": "Piwi Runner: the app that runs the tests a team instance asks for on this machine, with the window and the Node host that serve it",
  "license": "FSL-1.1-MIT",
  "type": "module",
  "scripts": {
    "runner:build": "node scripts/build.mjs",
    "runner:window": "nuxt generate",
    "runner:stage": "node scripts/stage.mjs",
    "runner:window:dev": "nuxt dev --strictPort",
    "runner:prepare": "nuxt prepare",
    "runner:test": "vitest run",
    "runner:test:watch": "vitest",
    "runner:typecheck": "tsc --noEmit -p tsconfig.host.json && nuxt typecheck",
    "runner:lint": "oxlint --config oxlint.config.mts .",
    "runner:lint:fix": "oxlint --config oxlint.config.mts . --fix",
    "runner:format": "oxfmt --config oxfmt.config.mts --write \"server/\" \"scripts/\" \"tests/\" \"app/\" \"nuxt.config.ts\"",
    "runner:format:check": "oxfmt --config oxfmt.config.mts --check \"server/\" \"scripts/\" \"tests/\" \"app/\" \"nuxt.config.ts\"",
    "test": "npm run runner:test"
  },
  "dependencies": {
    "@nuxt/ui": "^4.12.0",
    "@piwitests/editor": "*",
    "@vueuse/nuxt": "^15.0.0",
    "nuxt": "^4.6.4"
  },
  "devDependencies": {
    "@nuxt/kit": "^4.6.4",
    "esbuild": "^0.28.2",
    "vue-tsc": "3.3.11"
  }
}
