{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Piwi Dashboard",
  "version": "0.51.0",
  "identifier": "io.piwitests.dashboard",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Piwi Dashboard",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "dmg",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "fileAssociations": [
      {
        "ext": [
          "zip"
        ],
        "name": "Playwright archive",
        "description": "Playwright trace or blob report",
        "role": "Viewer",
        "mimeType": "application/zip"
      },
      {
        "ext": [
          "piwibug"
        ],
        "name": "Piwi bug report",
        "description": "Bug report recorded with Piwi Picker",
        "role": "Viewer",
        "rank": "Owner",
        "mimeType": "application/vnd.piwi.bug-report+zip",
        "contentTypes": [
          "io.piwitests.bug-report"
        ],
        "exportedType": {
          "identifier": "io.piwitests.bug-report",
          "conformsTo": [
            "public.zip-archive",
            "public.data"
          ]
        }
      }
    ],
    "resources": [
      "resources/app-server"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A permanent home for your Playwright test results.",
    "longDescription": "Piwi Dashboard keeps every Playwright run — traces, reports, flaky-test scoring, failure clustering, and locator healing — in a local dashboard that runs entirely on your machine. No server to set up, no data leaving your computer.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
