{
  "name": "@piwitests/dashboard",
  "version": "0.51.0",
  "private": true,
  "type": "module",
  "imports": {
    "#shared/*": "./shared/*.ts"
  },
  "scripts": {
    "app:generate": "nuxt generate",
    "app:generate:demo": "cross-env PIWI_DEMO_MODE=true nuxt generate",
    "app:generate:deploy": "node scripts/generate-deploy-manifests.mjs",
    "app:seed:demo": "node scripts/generate-demo-seed.mjs",
    "app:seed:dev": "node scripts/seed-dev-from-demo.mjs",
    "app:build": "nuxt build",
    "app:dev": "nuxt dev",
    "app:dev:bg": "node scripts/dev-server.mjs",
    "app:preview": "nuxt preview",
    "app:lint": "oxlint --config oxlint.config.ts .",
    "app:lint:fix": "oxlint --config oxlint.config.ts . --fix",
    "app:format": "oxfmt --config oxfmt.config.ts --write \".\"",
    "app:format:check": "oxfmt --config oxfmt.config.ts --check \".\"",
    "app:typecheck": "nuxt typecheck",
    "test": "cross-env NODE_OPTIONS=--expose-gc vitest run && playwright test",
    "app:test": "playwright test",
    "app:test:ai:live": "playwright test --config=tests/live/playwright.config.ts",
    "app:test:jira:live": "playwright test --config=tests/live/jira-live.config.ts",
    "app:test:unit": "cross-env NODE_OPTIONS=--expose-gc vitest run",
    "app:test:unit:coverage": "cross-env NODE_OPTIONS=--expose-gc vitest run --coverage",
    "app:test:ui": "playwright test --ui",
    "app:test:desktop": "cross-env PIWI_DESKTOP_E2E=1 playwright test",
    "app:test:report": "playwright show-report",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate:pg": "drizzle-kit generate --config=drizzle.config.pg.ts",
    "db:migrate:pg": "drizzle-kit migrate --config=drizzle.config.pg.ts",
    "db:push:pg": "drizzle-kit push --config=drizzle.config.pg.ts",
    "db:studio:pg": "drizzle-kit studio --config=drizzle.config.pg.ts",
    "app:check:demo": "node scripts/check-demo-routes.mjs",
    "app:check:demo:runtime": "node scripts/check-demo-runtime.mjs",
    "app:measure": "node scripts/measure-detail-pages.mjs",
    "app:perf": "node scripts/perf/run.mjs",
    "app:screens": "node scripts/take-feature-screenshots.mjs",
    "app:screens:docs": "node scripts/take-feature-screenshots.mjs --tag docs",
    "app:screens:check": "node scripts/take-feature-screenshots.mjs --check",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@aws-sdk/client-s3": "^3.1088.0",
    "@emnapi/core": "1.11.2",
    "@emnapi/runtime": "1.11.2",
    "@iconify-json/lucide": "^1.2.117",
    "@kubiks/otel-drizzle": "^2.1.0",
    "@libsql/client": "^0.17.4",
    "@nuxt/test-utils": "^4.0.2",
    "@nuxt/ui": "^4.11.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/nuxt": "^14.1.0",
    "busboy": "^1.6.0",
    "date-fns": "^4.1.0",
    "driver.js": "^1.8.0",
    "drizzle-orm": "^0.45.0",
    "fflate": "^0.8.2",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.6",
    "nodemailer": "^9.0.3",
    "nuxt": "^4.5.2",
    "pdf-lib": "^1.17.1",
    "pixelmatch": "^7.2.0",
    "postgres": "^3.4.9",
    "sharp": "^0.35.3",
    "sql.js": "^1.14.1",
    "vue-virtual-scroller": "^3.0.4",
    "write-excel-file": "^4.1.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@iconify-json/simple-icons": "^1.2.93",
    "@playwright/test": "^1.63.0",
    "@types/busboy": "^1.5.4",
    "@types/nodemailer": "^8.0.1",
    "@types/sql.js": "^1.4.11",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.8",
    "form-data": "^4.0.0",
    "monocart-reporter": "^2.12.2",
    "read-excel-file": "^9.3.10",
    "vue-tsc": "^3.3.7"
  },
  "optionalDependencies": {
    "@libsql/linux-x64-musl": "^0.5.29"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
