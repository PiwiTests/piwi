# Public URL, used for OG Image when running nuxt generate
PIWI_SITE_URL=

# Localization (optional). Instance-default date/time formatting; each viewer can
# still override it for their own browser under Settings > Localization.
# BCP-47 locale (e.g. fr-FR), or 'auto' to follow each viewer's browser. Unset keeps en-US.
PIWI_LOCALE=
# IANA time zone (e.g. Europe/Paris), or 'auto' (default) for each viewer's browser zone.
PIWI_TIME_ZONE=

# Secret key for encrypting sensitive values stored in the database (AI API keys, SCM tokens).
# Generate with: openssl rand -hex 32
# Recommended even without authentication enabled.
PIWI_SECRET_KEY=

# Authentication
# Set to 'true' to enable authentication
PIWI_AUTH_ENABLED=false
# Secret key for encrypting session cookies, at least 32 characters (required when PIWI_AUTH_ENABLED=true).
# Generate with: openssl rand -hex 32
PIWI_AUTH_SECRET=

# OAuth Authentication (optional, only configure providers you want to use)
# Google OAuth: https://console.developers.google.com/apis/credentials
PIWI_OAUTH_GOOGLE_CLIENT_ID=
PIWI_OAUTH_GOOGLE_CLIENT_SECRET=
# GitHub OAuth: https://github.com/settings/developers
PIWI_OAUTH_GITHUB_CLIENT_ID=
PIWI_OAUTH_GITHUB_CLIENT_SECRET=
# Optional OAuth access-control allowlists.
# Comma-separated verified email domains allowed to sign in (applies to all providers).
PIWI_OAUTH_ALLOWED_DOMAINS=
# Comma-separated GitHub org logins the user must belong to (requests read:org scope).
PIWI_OAUTH_GITHUB_ALLOWED_ORGS=
# Behind a reverse proxy, set PIWI_SITE_URL (below) so the OAuth redirect_uri
# matches what you registered with the provider.

# Database Configuration
# By default the dashboard uses a local SQLite database at .data/piwi.db
# To use PostgreSQL instead, set PIWI_DATABASE_URL to a valid connection string:
# PIWI_DATABASE_URL=postgresql://user:password@localhost:5432/piwi_dashboard
PIWI_DATABASE_URL=

# SQLite Settings (when PIWI_DATABASE_URL is not set)
# Path where the SQLite database file will be stored
PIWI_DATABASE_PATH=.data/piwi.db

# Storage Configuration
# Storage type: 'local' (default) or 's3'
PIWI_STORAGE_TYPE=local

# Local Storage Settings (when PIWI_STORAGE_TYPE=local)
# Path where files will be stored locally
PIWI_STORAGE_PATH=.data/storage

# S3 Storage Settings (when PIWI_STORAGE_TYPE=s3)
# AWS S3 bucket name
PIWI_S3_BUCKET=
# AWS region (e.g., us-east-1, eu-west-1)
PIWI_S3_REGION=
# AWS access key ID
PIWI_S3_ACCESS_KEY_ID=
# AWS secret access key
PIWI_S3_SECRET_ACCESS_KEY=
# Optional: Custom S3 endpoint (for S3-compatible services like MinIO, DigitalOcean Spaces, etc.)
PIWI_S3_ENDPOINT=

# AI Diagnosis Configuration (optional)
# Provider: 'anthropic' or 'openai' (OpenAI-compatible, e.g., ollama, vLLM, OpenRouter)
PIWI_AI_PROVIDER=
# API key for the provider (not required for local OpenAI-compatible servers)
PIWI_AI_API_KEY=
# Model to use (default: claude-opus-4-8 for anthropic; required for openai)
PIWI_AI_MODEL=
# Base URL (required for openai provider; optional proxy override for anthropic)
PIWI_AI_BASE_URL=
# Sampling temperature override, openai provider only (range 0-2). Omitted from requests when
# unset (provider default applies). Reasoning models (o1, o3, GPT-5-class) reject any explicit
# value, so leave this unset for them.
PIWI_AI_TEMPERATURE=
# Set to 'true' to automatically diagnose new failure clusters when a run finishes (max 3 per run)
PIWI_AI_AUTO_DIAGNOSE=false
# Optional research model (two-stage diagnosis) — a cheaper/faster pre-analysis pass.
# Provider/base URL/API key default to the main ones when omitted; temperature does not.
PIWI_AI_RESEARCH_MODEL=
PIWI_AI_RESEARCH_PROVIDER=
PIWI_AI_RESEARCH_BASE_URL=
PIWI_AI_RESEARCH_API_KEY=
PIWI_AI_RESEARCH_TEMPERATURE=
# Optional embedding model (semantic failure clustering). Anthropic has no embeddings API,
# so use an OpenAI-compatible endpoint (OpenAI, Voyage, or a local server like ollama).
PIWI_AI_EMBEDDING_PROVIDER=
PIWI_AI_EMBEDDING_MODEL=
PIWI_AI_EMBEDDING_BASE_URL=
PIWI_AI_EMBEDDING_API_KEY=
# Cosine similarity (0–1) above which two clusters are auto-merged (default 0.92)
# PIWI_CLUSTER_SIMILARITY_THRESHOLD=0.92
# Cosine similarity above which a pair enters the "ambiguous band" — adjudicated by the
# reasoning model when configured, otherwise surfaced as a merge suggestion (default 0.80)
# PIWI_CLUSTER_SUGGEST_THRESHOLD=0.80

# AI Diagnosis Context Limits (optional)
# Cap how much evidence is packed into each diagnosis (and therefore token cost).
# Defaults shown below; these are also editable in Settings → AI. When set, an
# env var takes precedence over the stored setting and the field becomes read-only in the UI.
# PIWI_AI_MAX_SAMPLE_ERROR_CHARS=10000    # characters of raw error text per error block
# PIWI_AI_MAX_SCM_PATCH_BUDGET=15000      # total characters of diff patches across files
# PIWI_AI_MAX_AFFECTED_TESTS=30           # affected tests listed
# PIWI_AI_MAX_STEPS=50                    # recent test steps included
# PIWI_AI_MAX_CONSOLE_ENTRIES=30          # console error/warning entries
# PIWI_AI_MAX_CONSOLE_ENTRY_CHARS=1000    # characters per console entry
# PIWI_AI_MAX_NETWORK_REQUESTS=25         # failed network requests included
# PIWI_AI_MAX_ARIA_SNAPSHOT_CHARS=12000   # characters of the page ARIA snapshot
# PIWI_AI_MAX_TEST_SOURCE_CHARS=8000      # characters of the test source snippet
# PIWI_AI_MAX_SOURCE_FILES=4              # full source files fetched from SCM to ground patches (0 disables)
# PIWI_AI_MAX_SOURCE_FILE_CHARS=12000     # characters per fetched full source file
# PIWI_AI_MAX_SERVER_LOG_ENTRIES=50       # backend server log entries (X-Piwi-Logs header)
# PIWI_AI_MAX_SERVER_LOG_ENTRY_CHARS=1000 # characters per backend server log entry
# PIWI_AI_MAX_IMAGES=5                    # screenshots auto-included in the context
# PIWI_AI_MAX_PASSED_PEERS=20             # passing peer tests in the same file listed
# PIWI_AI_MAX_CONSOLE_WINDOW=50           # console entries of any type in the window before failure
# PIWI_AI_SLOW_REQUEST_MS=1500            # duration (ms) above which a network request is flagged as slow
# PIWI_AI_MAX_TRACE_ACTIONS=10            # actions extracted from the trace ZIP for failing-action context (0 disables)
# PIWI_AI_TRACE_DOM_CHARS=6000            # characters of the trace-derived DOM/ARIA excerpt
# PIWI_AI_IMAGE_MAX_EDGE=1920             # screenshots are downscaled so their long edge is at most this many pixels
