{
  "name": "@piwitests/extension",
  "version": "0.51.0",
  "description": "Piwi Picker — a browser extension for ranked, stable Playwright locators, picked from the live page",
  "private": true,
  "type": "module",
  "scripts": {
    "extension:build": "node scripts/build.mjs",
    "extension:build:release": "node scripts/build.mjs --release",
    "extension:dev": "node scripts/dev.mjs",
    "extension:typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "extension:lint": "oxlint --config oxlint.config.mts .",
    "extension:lint:fix": "oxlint --config oxlint.config.mts . --fix",
    "extension:format": "oxfmt --config oxfmt.config.mts --write \"src/\" \"tests/\" \"scripts/\"",
    "extension:format:check": "oxfmt --config oxfmt.config.mts --check \"src/\" \"tests/\" \"scripts/\"",
    "extension:test": "vitest run",
    "extension:test:watch": "vitest",
    "extension:test:e2e": "npm run extension:build && playwright test --config=tests/e2e/playwright.config.ts",
    "extension:lab": "node tests/lab/run.mjs",
    "extension:zip": "npm run extension:build:release && node scripts/zip.mjs",
    "test": "npm run extension:test"
  },
  "dependencies": {
    "@piwitests/core": "*",
    "@piwitests/picker-dom": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.1.43",
    "archiver": "^7.0.1",
    "vite": "^8.0.16"
  }
}
