<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <PackageId>PiwiTests.Instrumentation.Serilog</PackageId>
    <Version>0.51.0</Version> <!-- x-release-please-version -->
    <Description>Serilog sink for Piwi Dashboard — WriteTo.PiwiTestLogs() feeds backend log events into the per-request capture sent to Playwright tests</Description>
    <Authors>piwitests</Authors>
    <RepositoryUrl>https://github.com/PiwiTests/platform</RepositoryUrl>
    <PackageProjectUrl>https://piwitests.dev</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>playwright;testing;serilog;instrumentation;logs</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Serilog" Version="3.1.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../aspnetcore/PiwiTests.Instrumentation.Core/PiwiTests.Instrumentation.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath=""/>
  </ItemGroup>
</Project>
