<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="Instrument">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The recorder is never instrumented, even when a build passes -p:Instrument=TestCoverage. -->
    <Instrument></Instrument>
    <PackageId>PiwiTests.Instrumentation.Coverage</PackageId>
    <Version>0.58.0</Version> <!-- x-release-please-version -->
    <Description>Per-test server code coverage for Piwi Dashboard: records which code each HTTP request executed in a build compiled with -p:PiwiCoverage=true, no ASP.NET Core dependency</Description>
    <Authors>piwitests</Authors>
    <RepositoryUrl>https://github.com/PiwiTests/platform</RepositoryUrl>
    <PackageProjectUrl>https://piwitests.dev</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>playwright;testing;instrumentation;coverage</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PiwiTests.Instrumentation.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath=""/>
    <None Include="build/PiwiTests.Instrumentation.Coverage.props" Pack="true" PackagePath="build/;buildTransitive/"/>
  </ItemGroup>
</Project>
