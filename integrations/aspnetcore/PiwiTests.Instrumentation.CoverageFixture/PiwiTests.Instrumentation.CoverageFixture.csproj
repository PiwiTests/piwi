<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
    <Instrument>TestCoverage</Instrument>
    <!-- coverlet.msbuild's exclusions, which the coverage package's props embed for the recorder. -->
    <ExcludeByAttribute>GeneratedCode</ExcludeByAttribute>
    <ExcludeByFile>**/Generated/*.cs</ExcludeByFile>
    <Exclude>[PiwiTests.Instrumentation.Coverage]*,[PiwiTests.Instrumentation.CoverageFixture]PiwiTests.Instrumentation.CoverageFixture.Legacy*</Exclude>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../PiwiTests.Instrumentation.Coverage/PiwiTests.Instrumentation.Coverage.csproj" />
  </ItemGroup>
  <Import Project="../PiwiTests.Instrumentation.Coverage/build/PiwiTests.Instrumentation.Coverage.props" />
</Project>
