<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <PackageId>PiwiTests.Instrumentation.Core</PackageId>
    <Version>0.51.0</Version> <!-- x-release-please-version -->
    <Description>Per-request backend log capture buffer shared by the Piwi Dashboard instrumentation packages — no ASP.NET Core dependency</Description>
    <Authors>piwitests</Authors>
    <RepositoryUrl>https://github.com/PiwiTests/platform</RepositoryUrl>
    <PackageProjectUrl>https://piwitests.dev</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>playwright;testing;instrumentation;logs</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PiwiTests.Instrumentation.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath=""/>
  </ItemGroup>
</Project>
