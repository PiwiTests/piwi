{
  "name": "@piwitests/instrumentation-nitro",
  "version": "0.61.0",
  "description": "Nitro/Nuxt server plugin for Piwi Dashboard: backend logs (X-Piwi-Logs), server spans, probes, the route manifest and per-test server coverage",
  "homepage": "https://piwitests.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/PiwiTests/piwi"
  },
  "bugs": {
    "url": "https://github.com/PiwiTests/piwi/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    },
    "./coverage-runtime": {
      "types": "./dist/coverage-runtime.d.ts",
      "import": "./dist/coverage-runtime.js"
    }
  },
  "keywords": [
    "nitro",
    "nuxt",
    "playwright",
    "piwi-dashboard",
    "server-logs",
    "test-results",
    "code-coverage"
  ],
  "author": "piwitests",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "magic-string": "^0.30.21"
  },
  "devDependencies": {
    "rollup": "^4.65.0"
  },
  "peerDependencies": {
    "consola": ">=3.0.0",
    "h3": ">=1.0.0",
    "nitropack": ">=2.0.0"
  }
}
