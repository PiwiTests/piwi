# Nuxt dev/build outputs
.output
.data
.nuxt
.nuxt-spec-gen
.nitro
.cache
dist
# The extension's Firefox build (apps/extension/scripts/build.mjs)
dist-firefox
# The extension's replay lab output (apps/extension/tests/lab)
apps/extension/tests/lab/out
# The VS Code builds the VS Code extension's integration tests download
.vscode-test
# The VS Code extension's changelog, which reusable-publish-vscode.yml writes into the package (scripts/ide-changelog.mjs)
apps/vscode/CHANGELOG.md
apps/vscode/tests/e2e/results/
apps/vscode/tests/e2e/report/
# The JetBrains plugin's Gradle outputs and the IDEs its tests and verifier download
apps/jetbrains/.gradle
apps/jetbrains/.intellijPlatform
apps/jetbrains/.kotlin
apps/jetbrains/build
apps/jetbrains/.ide

# Feature screenshots (scripts/take-feature-screenshots.mjs)
.screens

# Performance suite work directory and results (apps/application/scripts/perf)
.perf

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet

# Local env files
.env
.env.*
!.env.example

# VSC
.history

# Test artifacts
test-results/
playwright-report/
monocart-report/
blob-report/
coverage/

.test-temp/
.test-temp-zstd/
.test-temp-gzip/
.temp-dashboard/

# The throwaway tests a review writes to prove a finding (AGENTS.md, "Review before you call a change done").
*.scratch.test.ts
*.scratch.spec.ts

# Live AI E2E scratch: the throwaway server state and the artifacts the
# authoring run writes instead of committing.
.live-temp/
.ai-live-artifacts/


# Playwright artifacts
.playwright-cli/
.playwright-mcp/

# Build artifacts
obj/
bin/

# Generated demo seed (regenerated by `npm run app:seed:demo`, and in CI before
# the demo build). Only the seed.version.json marker is committed.
apps/application/public/demo/seed.sql

# Plan documents
plans/

# Generated docs (rebuilt by docs:gen from their registries, see apps/docs/AGENTS.md)
apps/docs/reference/analytics-widgets.md
apps/docs/reference/configuration.md
apps/docs/reference/features.md
apps/docs/reference/mcp-tools.md
apps/docs/reference/metrics.md
apps/docs/reference/reporter-options.md
apps/docs/reference/whats-new.md
apps/docs/public/llms.txt
apps/docs/public/llms-full.txt

# Extension distributable zips and AMO listing metadata (regenerated by `npm run extension:zip`).
apps/extension/*.zip
apps/extension/*-amo-metadata.json

# Desktop (Tauri) build artifacts — all regenerated by the build (see
# apps/desktop/README.md and .github/workflows/desktop-release.yml)
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/binaries/
apps/desktop/src-tauri/icons/
apps/desktop/src-tauri/resources/
# Permission files Tauri autogenerates from the build.rs app-manifest command list.
apps/desktop/src-tauri/permissions/autogenerated/
# Desktop e2e (Playwright) install + run artifacts.
apps/desktop/node_modules/
apps/desktop/playwright-report/
apps/desktop/test-results/
