{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    // Inside the Piwi repository, the Nitro integration's source, as backends/nitro/nitro.config.ts builds it;
    // copied anywhere else, the path does not exist and the npm package is used.
    "paths": { "@piwitests/instrumentation-nitro": ["../../integrations/nitro/src/index.ts"] }
  },
  "include": ["tests/**/*.ts", "backends.ts", "playwright*.ts", "backends/nitro/**/*.ts", "backends/nitro.tests/**/*.ts"],
  "exclude": ["backends/nitro/.nitro"]
}
