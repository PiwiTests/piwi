# Copy to .env: playwright.config.ts, the editor extensions and scripts/register-functions.mjs read it.
PIWI_DASHBOARD_URL=http://localhost:3000
# The project each backend reports to, sample-app-<backend> when unset.
# PIWI_PROJECT_NAME=sample-app-aspnetcore
# An API key of the instance, when it has sign-in (Settings → API keys); leave it out for a local dashboard without.
# PIWI_API_KEY=pd_...
# The shopper's password the shop tests type.
E2E_PASSWORD=demo-password
