{
  "name": "piwi-sample-app",
  "private": true,
  "version": "0.0.0",
  "description": "Runnable sample: one web app served by each supported backend with its Piwi integration, and the Playwright suite they share",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:aspnetcore": "playwright test",
    "start:aspnetcore": "dotnet run --project backends/aspnetcore -p:PiwiCoverage=true",
    "typecheck": "tsc --noEmit",
    "demo:functions": "node scripts/register-functions.mjs"
  },
  "devDependencies": {
    "@piwitests/reporter": "0.52.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.1.1",
    "typescript": "^6.0.3"
  }
}
