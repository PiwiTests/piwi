{
  "name": "suitetune",
  "version": "0.1.0",
  "description": "Make a Playwright suite faster without forking Playwright: public levers for your config, and experimental, version-pinned hooks, with the benchmark to judge them",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./test": {
      "types": "./src/test.d.ts",
      "default": "./src/test.mjs"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test tests/unit.test.mjs bench/tests/*.test.mjs",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "bench": "node bench/cli.mjs run --config bench/workload/bench.config.mjs",
    "bench:profile": "node bench/cli.mjs profile --config bench/workload/bench.config.mjs"
  },
  "keywords": [
    "playwright",
    "performance",
    "e2e",
    "testing",
    "benchmark"
  ],
  "engines": {
    "node": ">=22.1.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50.0 <2"
  }
}
