{
  "name": "@piwitests/run-ui",
  "version": "0.69.0",
  "description": "The Nuxt layer shared by the dashboard and Piwi Runner: the team run request confirmation, the connection card, the live view of the runs the shell starts, and the helpers they use",
  "private": true,
  "license": "FSL-1.1-MIT",
  "type": "module",
  "exports": {
    "./highlight": "./src/highlight.ts",
    "./text": "./app/utils/text.ts",
    "./ansi": "./app/utils/ansi.ts",
    "./fold-text": "./src/fold-text.ts",
    "./run-view": "./app/utils/run-view.ts",
    "./status-palette": "./app/utils/status-palette.ts",
    "./ui-classes": "./app/utils/ui-classes.ts",
    "./run-ui.css": "./app/assets/css/run-ui.css"
  },
  "scripts": {
    "run-ui:test": "vitest run",
    "run-ui:test:watch": "vitest",
    "run-ui:typecheck": "tsc --noEmit -p tsconfig.json",
    "run-ui:lint": "oxlint --config oxlint.config.mts .",
    "run-ui:lint:fix": "oxlint --config oxlint.config.mts . --fix",
    "run-ui:format": "oxfmt --config oxfmt.config.mts --write \"src/\" \"app/\" \"tests/\" \"nuxt.config.ts\"",
    "run-ui:format:check": "oxfmt --config oxfmt.config.mts --check \"src/\" \"app/\" \"tests/\" \"nuxt.config.ts\"",
    "test": "npm run run-ui:test"
  },
  "dependencies": {
    "@piwitests/core": "*",
    "@piwitests/editor": "*",
    "@piwitests/picker-dom": "*",
    "@piwitests/run-model": "*",
    "highlight.js": "^11.12.0"
  },
  "devDependencies": {
    "@nuxt/kit": "^4.6.4"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.12.0",
    "@vueuse/nuxt": "*",
    "nuxt": "^4.6.4"
  }
}
