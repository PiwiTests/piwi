{
  "name": "@piwitests/editor",
  "version": "0.70.0",
  "description": "The Piwi editor service: a language server that shows a suite's history and the locators a change breaks in VS Code and the JetBrains IDEs",
  "private": true,
  "license": "FSL-1.1-MIT",
  "type": "module",
  "exports": {
    ".": "./src/server.ts",
    "./protocol": "./src/protocol.ts",
    "./actions": "./src/actions.ts",
    "./connect-failures": "./src/connect-failures.ts",
    "./discovery": "./src/discovery.ts",
    "./run-host": "./src/run-host.ts",
    "./request-host": "./src/request-host.ts",
    "./request-run": "./src/request-run.ts",
    "./host-guard": "./src/host-guard.ts",
    "./run-target": "./src/run-target.ts",
    "./run-target-routes": "./src/run-target-routes.ts",
    "./run-target-http": "./src/run-target-http.ts",
    "./run-target-session": "./src/run-target-session.ts",
    "./run-target-stream": "./src/run-target-stream.ts",
    "./desktop-page": "./src/desktop-page.ts",
    "./run-target-view": "./src/run-target-view.ts",
    "./shell-runs": "./src/shell-runs.ts",
    "./shell-runs-routes": "./src/shell-runs-routes.ts",
    "./shell-run-events": "./src/shell-run-events.ts",
    "./shell-runs-http": "./src/shell-runs-http.ts",
    "./mcp-protocol": "./src/mcp-protocol.ts",
    "./server": "./dist/piwi-language-server.cjs"
  },
  "scripts": {
    "editor:build": "node build.mjs",
    "editor:typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "editor:test": "vitest run",
    "editor:test:watch": "vitest",
    "editor:lint": "oxlint --config oxlint.config.mts .",
    "editor:lint:fix": "oxlint --config oxlint.config.mts . --fix",
    "editor:format": "oxfmt --config oxfmt.config.mts --write \"src/\" \"tests/\"",
    "editor:format:check": "oxfmt --config oxfmt.config.mts --check \"src/\" \"tests/\"",
    "test": "npm run editor:test"
  },
  "dependencies": {
    "@piwitests/core": "*",
    "undici": "^8.12.3",
    "vscode-languageserver": "^11.0.0",
    "vscode-languageserver-textdocument": "^1.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "vscode-jsonrpc": "^9.0.3",
    "ws": "^8.22.0"
  }
}
